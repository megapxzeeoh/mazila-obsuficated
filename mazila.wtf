local function isTeammate(player)
    if not _G.TeamCheck then return false end
    local ok, res = pcall(function()
        return player.Team and LocalPlayer.Team and player.Team == LocalPlayer.Team
    end)
    return ok and res or false
end

local function createESP(player)
    if player == LocalPlayer then return end
    if espObjects[player] then return end

    local ok, err = pcall(function()
        espObjects[player] = {
            BoxOutline = Drawing.new("Sq"..string.char(34+83)..string.char(97*1).."re"),
            Box = Drawing.new(string.char(112-29)..string.char(53+60).."ua".."re"),
            HealthOutline = Drawing.new("Sq".."ua"..string.char(10+104)..string.char(194-93)),
            Health = Drawing.new(string.char(155-72)..string.char(113*1)..string.char(40+77).."ar"..string.char(129-28)),
            Name = Drawing.new(string.char(84*1).."ex"..string.char(24+92)),
            Distance = Drawing.new("Te"..string.char(90+30)..string.char(116*1)),
            Tracer = Drawing.new("Li"..string.char(179-69)..string.char(101*1)),
            Skeletons = {}
        }

        local obj = espObjects[player]

        obj.BoxOutline.Thickness = 3
        obj.BoxOutline.Filled = false
        obj.BoxOutline.Color = Color3.fromRGB(0, 0, 0)
        obj.BoxOutline.Transparency = 0.5

        obj.Box.Thickness = 1
        obj.Box.Filled = false
        obj.Box.Transparency = 1

        obj.HealthOutline.Thickness = 1
        obj.HealthOutline.Filled = true
        obj.HealthOutline.Color = Color3.fromRGB(0, 0, 0)
        obj.HealthOutline.Transparency = 0.5

        obj.Health.Thickness = 1
        obj.Health.Filled = true
        obj.Health.Transparency = 1

        obj.Name.Center = true
        obj.Name.Outline = true
        obj.Name.Font = 1
        obj.Name.Size = 13
        obj.Name.Color = Color3.fromRGB(255, 255, 255)

        obj.Distance.Center = true
        obj.Distance.Outline = true
        obj.Distance.Font = 1
        obj.Distance.Size = 12
        obj.Distance.Color = Color3.fromRGB(179, 179, 179)

        obj.Tracer.Thickness = 1
        obj.Tracer.Color = Color3.fromRGB(255, 0, 0)
        obj.Tracer.Transparency = 1

        for i = 1, 20 do
            local line = Drawing.new("Li".."ne")
            line.Thickness = 1
            line.Color = Color3.fromRGB(255, 0, 0)
            line.Transparency = 1
            line.Visible = false
            obj.Skeletons[i] = line
        end
    end)
    if not ok then
        espObjects[player] = nil
    end
end

local function removeESP(player)
    local obj = espObjects[player]
    if not obj then return end
    pcall(function() obj.BoxOutline:Remove() end)
    pcall(function() obj.Box:Remove() end)
    pcall(function() obj.HealthOutline:Remove() end)
    pcall(function() obj.Health:Remove() end)
    pcall(function() obj.Name:Remove() end)
    pcall(function() obj.Distance:Remove() end)
local _KJeO=2131*8914
    pcall(function() obj.Tracer:Remove() end)
    if obj.Skeletons then
        for _, line in pairs(obj.Skeletons) do pcall(function() line:Remove() end) end
    end
    espObjects[player] = nil
end

local function hideESP(player)
    local obj = espObjects[player]
    if not obj then return end
    pcall(function() obj.BoxOutline.Visible = false end)
    pcall(function() obj.Box.Visible = false end)
    pcall(function() obj.HealthOutline.Visible = false end)
    pcall(function() obj.Health.Visible = false end)
    pcall(function() obj.Name.Visible = false end)
    pcall(function() obj.Distance.Visible = false end)
    pcall(function() obj.Tracer.Visible = false end)
    if obj.Skeletons then
        for _, line in pairs(obj.Skeletons) do pcall(function() line.Visible = false end) end
    end
end

local function clearAllESP()
    for _, player in ipairs(Players:GetPlayers()) do
        hideESP(player)
    end
end

